rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@atharvelectrical.com'
      );
    }

    // Public read for store images
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /subcategories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /brands/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fallback: authenticated admin only
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
