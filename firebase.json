{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/cashfree/create-order",
        "function": "createCashfreeOrder"
      },
      {
        "source": "/api/cashfree/verify-payment",
        "function": "verifyCashfreePayment"
      },
      {
        "source": "/api/cashfree/webhook",
        "function": "cashfreeWebhook"
      },
      {
        "source": "/api/cashfree/order-status",
        "function": "cashfreeOrderStatus"
      },
      {
        "source": "/api/cashfree/refund",
        "function": "cashfreeRefund"
      },
      {
        "source": "/api/create-razorpay-order",
        "function": "createRazorpayOrder"
      },
      {
        "source": "/api/verify-razorpay-payment",
        "function": "verifyRazorpayPayment"
      },
      {
        "source": "/api/shiprocket/check-serviceability",
        "function": "shiprocketCheckServiceability"
      },
      {
        "source": "/api/shiprocket/create-shipment",
        "function": "shiprocketCreateShipment"
      },
      {
        "source": "/api/shiprocket/generate-awb",
        "function": "shiprocketGenerateAwb"
      },
      {
        "source": "/api/shiprocket/schedule-pickup",
        "function": "shiprocketSchedulePickup"
      },
      {
        "source": "/api/shiprocket/generate-label",
        "function": "shiprocketGenerateLabel"
      },
      {
        "source": "/api/shiprocket/cancel-shipment",
        "function": "shiprocketCancelShipment"
      },
      {
        "source": "/api/shiprocket/track",
        "function": "shiprocketTrackShipment"
      },
      {
        "source": "/api/shiprocket/webhook",
        "function": "shiprocketWebhook"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "auth": {
    "providers": {
      "anonymous": true,
      "emailPassword": true
    }
  }
}
